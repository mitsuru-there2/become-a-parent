  "scenes": {
    "baby": {
      "title": "小さな寝息のある暮らし",
      "text": "洗いかけの哺乳瓶。畳み途中の洗濯物。\n小さな寝息を聞きながら、今日の予定を組み直す。",
      "visual": "stage-baby"
    },
    "preschool": {
      "title": "「なんで？」が増える頃",
      "text": "玄関の小さな靴。ポケットの中には、いつの間にか石。\n出かけるだけでも、ひとつの冒険になる。",
      "visual": "stage-preschool"
    },
    "primary": {
      "title": "「ただいま」のその先に",
      "text": "机に置かれた連絡帳。明日の持ち物が、またひとつ。\n家の外の世界が、少しずつ広がっていく。",
      "visual": "stage-primary"
    },
    "junior": {
      "title": "近すぎず、遠すぎず",
      "text": "少し大きくなった靴が、玄関に並ぶ。\n声をかけるタイミングを考えながら、夕飯の支度をする。",
      "visual": "stage-junior"
    },
    "senior": {
      "title": "未来の話をする食卓",
      "text": "机の上には、進路の資料と飲みかけのお茶。\nこれからの話に、今日はゆっくり耳を傾けよう。",
      "visual": "stage-senior"
    },
    "launch": {
      "title": "手を離す練習",
      "text": "予定表に、家族それぞれの用事が増えていく。\nいつもの食卓で、この先の暮らしを思い描く。",
      "visual": "stage-launch"
    }
  },
