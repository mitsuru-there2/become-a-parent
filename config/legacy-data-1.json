  "text": {
    "simulation_000": "余裕がありそう",
    "simulation_001": "少し疲れている様子",
    "simulation_002": "休みたがることが増えた",
    "simulation_003": "反応が少ない",
    "simulation_004": "声や気配に反応する",
    "simulation_005": "自分から触れ合いを求める",
    "simulation_006": "話しかけても会話が続きにくい",
    "simulation_007": "用事や近況を話す",
    "simulation_008": "自分から話をしに来る",
    "simulation_009": "決めてもらうのを待つことが多い",
    "simulation_010": "選択肢を示すと選ぶ",
    "simulation_011": "自分の希望を言う",
    "simulation_012": "ことばや数の遊び：",
    "simulation_013": "形や音の遊び：",
    "simulation_014": "学習：",
    "simulation_015": "創作：",
    "simulation_016": "最近は話題にしない",
    "simulation_017": "誘うと取り組むことがある",
    "simulation_018": "自分から話題にする",
    "simulation_019": "試しながら覚えている",
    "simulation_020": "一人でできることが増えた",
    "simulation_021": "得意なこととして披露する",
    "simulation_022": "新しい場の後は疲れている様子",
    "simulation_023": "前より余裕が出てきた様子",
    "simulation_024": "疲れが続いて増えている様子",
    "simulation_025": "疲れが続いて和らいでいる様子",
    "simulation_026": "調子には波がある",
    "simulation_027": "学習",
    "simulation_028": "創作",
    "simulation_029": "祖父母の体力か関係に余裕がありません",
    "simulation_030": "乳児期の遊びは関わりの時間で扱います",
    "simulation_031": "出来事への回答が必要です（費用0の選択肢もあります）",
    "simulation_032": "祖父母の援助資金が足りません",
    "simulation_033": "予測残金が不足しています",
    "simulation_034": "春〜夏",
    "simulation_035": "秋〜冬",
    "simulation_036": "忘れていた返金。家計簿が一瞬だけ拍手した。",
    "simulation_037": "家電が、今しかないという顔で止まった。",
    "simulation_038": "残金の範囲に修理を縮小した。負債はない。",
    "simulation_039": "家族の妙な作品が回覧板の表紙になった。",
    "simulation_040": "少し間を置いて、また取り組み始めた。",
    "simulation_041": "再開はまだ先になりそう。",
    "simulation_042": "あの会話のあと、少し話しやすくなった様子。",
    "simulation_043": "話しやすさが続くか、もう少し様子を見たい。",
    "adult_044": "満ち足りた振り返り",
    "adult_045": "喜びと心残りのある振り返り",
    "adult_046": "心残りの大きい振り返り",
    "adult_047": "小さな靴、大きな予定",
    "adult_048": "靴箱を片づけると、小さな靴が出てきた。予定通りのことも、そうでないこともあった。家族の歩みは、この一足には収まりきらない。",
    "adult_049": "立派な額縁、静かな食卓",
    "adult_050": "壁には立派な額縁が並んだ。食卓には、聞きそびれた話が残った。大きな成果と、親子それぞれの実感を振り返る。",
    "adult_051": "「あのとき、ごめん」の続き",
    "adult_052": "昔の言い争いを話せる日が来た。謝罪の名文句は忘れたが、そのあとに続いた会話は覚えている。",
    "adult_053": "それぞれの予定表",
    "adult_054": "親の予定表にも、子どもの予定表にも、別々の用事がある。家族の予定を合わせる係は、最後までなかなか忙しかった。",
    "adult_055": "遠くの街から、いつもの声",
    "adult_056": "遠くの街から電話が鳴る。最初の話題はいつも天気。大事な話は、だいたいそのあとにやってきた。",
    "adult_057": "近況の連絡が届いた。",
    "adult_058": "連絡は用件が中心だった。",
    "adult_059": "退職後にも会う人と予定がある。",
    "adult_060": "仕事の外の過ごし方を探し始めた。",
    "adult_061": "妙な作品が、まだ家に残っている。",
    "adult_062": "学びを生かす専門の道",
    "adult_063": "作ることを仕事にする道",
    "adult_064": "試しながら自分の道を探す",
    "adult_065": "相談しながら足場を作る",
    "adult_066": "遠方で暮らす。",
    "adult_067": "近くで暮らす。",
    "adult_068": "回覧板を飾った作品は、家族の思い出になった。"
  }
