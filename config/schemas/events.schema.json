                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "enum": ["eq", "lt", "gte"],
                    "type": "string"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
