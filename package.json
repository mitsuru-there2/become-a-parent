{
  "name": "become-a-parent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp build",
    "preview": "vp preview --host 127.0.0.1",
    "check": "bun run lint:json && vp check",
    "lint": "bun run lint:json && vp lint --max-warnings=0",
    "format": "vp fmt",
    "test": "vp test run",
    "cli": "bun scripts/cli.ts",
    "deploy": "bun run build && wrangler deploy",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "deploy:login": "wrangler login",
    "deploy:whoami": "wrangler whoami",
    "test:browser": "bun scripts/browser-check.ts",
    "test:public": "bun scripts/public-play.ts",
    "test:stories": "bun scripts/story-play.ts",
    "check:content": "bun scripts/check-content.ts",
    "schema:generate": "bun scripts/generate-json-schemas.ts && vp fmt config/schemas",
    "schema:check": "bun scripts/generate-json-schemas.ts --check",
    "lint:json": "bun run packs:check && bun run schema:check && bun run check:json && bun run check:content",
    "check:json": "bun scripts/check-json.ts",
    "format:check": "vp fmt --check",
    "hooks:install": "lefthook install",
    "prepare": "lefthook install",
    "packs:generate": "bun scripts/generate-packs.ts",
    "packs:check": "bun scripts/generate-packs.ts --check"
  },
  "dependencies": {
    "@nanostores/react": "2.0.1",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-start": "1.168.54",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "motion": "13.3.0",
    "nanostores": "1.5.3",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@valibot/to-json-schema": "1.8.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "lefthook": "2.1.14",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
    "vite-plus": "0.3.2",
    "vscode-json-languageservice": "6.0.0-next.3",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.3.14"
}
